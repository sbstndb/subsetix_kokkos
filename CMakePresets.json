{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "serial",
      "displayName": "Kokkos SERIAL backend",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-serial",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "openmp",
      "displayName": "Kokkos OPENMP + SERIAL backends",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-openmp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_KOKKOS_OPENMP": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "cuda",
      "displayName": "Kokkos CUDA + SERIAL backends (GCC 14)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_KOKKOS_CUDA": "ON",
        "CMAKE_CXX_COMPILER": "g++-14",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "serial-asan",
      "displayName": "Kokkos SERIAL backend with sanitizers (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-serial-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-g -O1 -fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "mpi-serial",
      "displayName": "MPI + Kokkos SERIAL",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-mpi-serial",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_USE_MPI": "ON"
      }
    },
    {
      "name": "mpi-openmp",
      "displayName": "MPI + Kokkos OPENMP",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-mpi-openmp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_KOKKOS_OPENMP": "ON",
        "SUBSETIX_USE_MPI": "ON"
      }
    },
    {
      "name": "mpi-cuda",
      "displayName": "MPI + Kokkos CUDA (GCC 14)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-mpi-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_KOKKOS_CUDA": "ON",
        "CMAKE_CXX_COMPILER": "g++-14",
        "SUBSETIX_USE_MPI": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Code Coverage (Serial, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SUBSETIX_ENABLE_COVERAGE": "ON",
        "SUBSETIX_KOKKOS_OPENMP": "OFF",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "experimental-serial",
      "displayName": "Experimental module only (Serial)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-experimental-serial",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_EXPERIMENTAL": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "experimental-asan",
      "displayName": "Experimental module only (Serial + Sanitizers)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-experimental-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-g -O1 -fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "SUBSETIX_ENABLE_EXPERIMENTAL": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "experimental-openmp",
      "displayName": "Experimental module only (OpenMP)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-experimental-openmp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_EXPERIMENTAL": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_OPENMP": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "experimental-cuda",
      "displayName": "Experimental module only (CUDA + GCC 14)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-experimental-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_EXPERIMENTAL": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_CUDA": "ON",
        "CMAKE_CXX_COMPILER": "g++-14",
        "SUBSETIX_USE_MPI": "OFF"
      }
    }
  ],
  "buildPresets": [
