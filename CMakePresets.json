{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "serial",
      "displayName": "Kokkos SERIAL backend",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-serial",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "openmp",
      "displayName": "Kokkos OPENMP + SERIAL backends",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-openmp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_KOKKOS_OPENMP": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "cuda",
      "displayName": "Kokkos CUDA + SERIAL backends",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_KOKKOS_CUDA": "ON",
        "CMAKE_CXX_COMPILER": "g++",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "serial-asan",
      "displayName": "Kokkos SERIAL backend with sanitizers (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-serial-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-g -O1 -fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Code Coverage (Serial, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SUBSETIX_ENABLE_COVERAGE": "ON",
        "SUBSETIX_KOKKOS_OPENMP": "OFF",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-serial",
      "displayName": "Playground module only (Serial)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-serial",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-asan",
      "displayName": "Playground module only (Serial + Sanitizers)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-g -O1 -fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-openmp",
      "displayName": "Playground module only (OpenMP)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-openmp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_OPENMP": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-cuda",
      "displayName": "Playground module only (CUDA)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_CUDA": "ON",
        "CMAKE_CXX_COMPILER": "g++",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-perf-serial",
      "displayName": "Playground module only (Serial + Linux perf profiling)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-perf-serial",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_ENABLE_PROFILING_PERF": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-perf-openmp",
      "displayName": "Playground module only (OpenMP + Linux perf profiling)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-perf-openmp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_OPENMP": "ON",
        "SUBSETIX_ENABLE_PROFILING_PERF": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-serial-profile",
      "displayName": "Playground module only (Serial + Kokkos profiling tools)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-serial-profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_ENABLE_PROFILING_KOKKOS": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-openmp-profile",
      "displayName": "Playground module only (OpenMP + Kokkos profiling tools)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-openmp-profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_OPENMP": "ON",
        "SUBSETIX_ENABLE_PROFILING_KOKKOS": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "playground-cuda-profile",
      "displayName": "Playground module only (CUDA + Kokkos profiling tools)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground-cuda-profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_CUDA": "ON",
        "CMAKE_CXX_COMPILER": "g++",
        "SUBSETIX_ENABLE_PROFILING_KOKKOS": "ON",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "profiling-nsight-cuda",
      "displayName": "Profiling preset (CUDA + Nsight, playground only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-profiling-nsight-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_ENABLE_PROFILING_CUDA": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_CUDA": "ON",
        "CMAKE_CXX_COMPILER": "g++",
        "SUBSETIX_USE_MPI": "OFF"
      }
    },
    {
      "name": "profiling-nsight-cuda-release",
      "displayName": "Profiling preset (CUDA + Nsight, Release with symbols, playground only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-profiling-nsight-cuda-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-g",
        "SUBSETIX_ENABLE_PLAYGROUND": "ON",
        "SUBSETIX_ENABLE_PROFILING_CUDA": "ON",
        "SUBSETIX_BUILD_STABLE_LIBS": "OFF",
        "SUBSETIX_BUILD_STABLE_TESTS": "OFF",
        "SUBSETIX_BUILD_STABLE_BENCHMARKS": "OFF",
        "SUBSETIX_KOKKOS_CUDA": "ON",
        "CMAKE_CXX_COMPILER": "g++",
        "SUBSETIX_USE_MPI": "OFF"
      }
    }
