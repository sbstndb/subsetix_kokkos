    },
    {
      "name": "mpi-cuda",
      "configurePreset": "mpi-cuda"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "experimental-serial",
      "configurePreset": "experimental-serial"
    },
    {
      "name": "experimental-asan",
